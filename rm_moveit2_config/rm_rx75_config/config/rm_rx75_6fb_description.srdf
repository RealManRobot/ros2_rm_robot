<?xml version="1.0" encoding="UTF-8"?>
<robot name="rm_rx75_dual">
  <group name="left_arm">
    <chain base_link="left_base_link" tip_link="left_tool0"/>
  </group>

  <group name="right_arm">
    <chain base_link="right_base_link" tip_link="right_tool0"/>
  </group>

  <group name="dual_arms">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>

  <group_state name="zero" group="left_arm">
    <joint name="left_joint1" value="0"/>
    <joint name="left_joint2" value="0"/>
    <joint name="left_joint3" value="0"/>
    <joint name="left_joint4" value="0"/>
    <joint name="left_joint5" value="0"/>
    <joint name="left_joint6" value="0"/>
    <joint name="left_joint7" value="0"/>
  </group_state>

  <group_state name="forward" group="left_arm">
    <joint name="left_joint1" value="0"/>
    <joint name="left_joint2" value="-0.8395"/>
    <joint name="left_joint3" value="0"/>
    <joint name="left_joint4" value="-1.4442"/>
    <joint name="left_joint5" value="0"/>
    <joint name="left_joint6" value="-0.8513"/>
    <joint name="left_joint7" value="0"/>
  </group_state>

  <group_state name="zero" group="right_arm">
