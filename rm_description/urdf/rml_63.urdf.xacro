<?xml version="1.0" encoding="utf-8"?>
<robot  name="rml_63_description" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- link6_type -->
    <xacro:arg name="link6_type" default="Link6" />
    <xacro:arg name="base_type" default="base_link" />
    <!-- arg->property -->
    <xacro:property name="link6_type" value="$(arg link6_type)" />
    <xacro:property name="base_type" value="$(arg base_type)" />
    <!-- RML63II and RML63III use different link geometry. Keep each URDF
         coordinate system paired with the meshes exported for that model. -->
    <xacro:property name="mesh_dir" value="${'rm_63_III_arm' if base_type == 'base_link_III' else 'rm_63_arm'}" />
    <xacro:if value="${ base_type =='base_link' }">
    <link
    name="base_link">
    <inertial>
      <origin
        xyz="0.0014213 -0.00010164 0.050087"
        rpy="0 0 0" />
      <mass
        value="1.862" />
      <inertia
        ixx="0.00099641"
        ixy="-3.2815E-06"
        ixz="1.0053E-05"
        iyy="0.0010164"
        iyz="-1.2859E-06"
        izz="0.00067934" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://rm_description/meshes/${mesh_dir}/base_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.86667 0.86667 0.8902 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://rm_description/meshes/${mesh_dir}/base_link.STL" />
      </geometry>
    </collision>
  </link>
  <link
    name="link1">
    <inertial>
      <origin
        xyz="-0.068442 -0.023913 -0.006938"
        rpy="0 0 0" />
      <mass
        value="1.837" />
      <inertia
        ixx="0.002323337"
        ixy="-0.000758998"
        ixz="0.000825985"
        iyy="0.003950377"
        iyz="0.000254693"
        izz="0.003921999" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://rm_description/meshes/${mesh_dir}/link1.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://rm_description/meshes/${mesh_dir}/link1.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="joint1"
    type="revolute">
    <origin
      xyz="0 0 0.172"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="link1" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-3.106"
      upper="3.106"
      effort="60"
      velocity="3.14" />
  </joint>
  </xacro:if>
<xacro:if value="${ base_type =='base_link_III' }">
